# Prisma reads DATABASE_URL (recommended)
# Database name is required in the path (e.g. /gelos before ?)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/gelos?retryWrites=true&w=majority

# Legacy alias — also supported if DATABASE_URL is unset
MONGODB_URI=

# UploadThing — file storage for admin product images & branding
# Create a token at https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Paystack — checkout payments for Ghana / Nigeria / international (secret key stays server-side only)
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=

# Stripe — card payments on Gelos /checkout (PaymentIntent + Elements)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key is required for on-page card fields (pk_test_… / pk_live_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# DHL Express (MyDHL API) — live shipping rates at /checkout
# https://developer.dhl.com/api-reference/dhl-express-mydhl-api
# Request API Key + Secret via DHL Developer Portal (needs Express account).
# ---------------------------------------------------------------------------
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
# test | production
DHL_ENV=test
# Ship-from warehouse (required for rates)
DHL_SHIPPER_COUNTRY_CODE=GH
DHL_SHIPPER_CITY=Accra
DHL_SHIPPER_POSTAL_CODE=
# Optional package defaults (metric)
# DHL_DEFAULT_WEIGHT_KG=0.5
# DHL_WEIGHT_PER_ITEM_KG=0.35
# DHL_DEFAULT_LENGTH_CM=25
# DHL_DEFAULT_WIDTH_CM=20
# DHL_DEFAULT_HEIGHT_CM=10

# ---------------------------------------------------------------------------
# Shopify Storefront (hybrid commerce — keep Next.js UI, Shopify checkout/ads)
# ---------------------------------------------------------------------------
# 1. Shopify Admin → Settings → Apps and sales channels → Develop apps
# 2. Create an app → Configure Storefront API scopes:
#      unauthenticated_read_product_listings
#      unauthenticated_read_product_inventory (optional, for stock)
#      unauthenticated_write_checkouts / unauthenticated_read_checkouts
#      (Cart API: unauthenticated_write_checkouts is covered by Storefront cart)
#    Prefer Cart scopes available in your API version, e.g.:
#      unauthenticated_read_product_listings
#      unauthenticated_read_product_inventory
#      unauthenticated_write_checkouts
# 3. Install app → copy Storefront API access token
# 4. Store domain is your *.myshopify.com host (no https://)
#
# When Storefront credentials are set, catalog uses Shopify by default.
# To run without a paid Shopify plan (Gelos products + Gelos checkout):
#   SHOPIFY_CATALOG_ENABLED=false
#   SHOPIFY_COMMERCE_ENABLED=false
# Checkout only off Shopify (catalog still Shopify):
#   SHOPIFY_COMMERCE_ENABLED=false
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_STOREFRONT_API_VERSION=2025-01
# SHOPIFY_COMMERCE_ENABLED=false
# SHOPIFY_CATALOG_ENABLED=false
#
# IMPORTANT (headless): Shopify checkout URLs use the store PRIMARY domain.
# If gelosglobal.com / www points at Vercel, /cart/c/* 404s.
# Recommended branded setup:
# 1. DNS: CNAME checkout → shops.myshopify.com
# 2. Shopify Admin → Settings → Domains → add checkout.gelosglobal.com
# 3. Set checkout.gelosglobal.com as the PRIMARY domain
# 4. Keep www / apex on Vercel for the Next.js storefront
# SHOPIFY_CHECKOUT_DOMAIN=checkout.gelosglobal.com
#
# Meta ads: install Facebook & Instagram channel in Shopify Admin on this store.
# Purchases on Shopify Checkout are attributed via that channel.
#
# PDP feature gallery (lifestyle photos/videos under the product — not Media):
# 1. Shopify Admin → Settings → Custom data → Products → Add definition
# 2. Name: Gallery | Namespace and key: custom.gallery
# 3. Type: List of files (images and videos)
# 4. Enable Storefront API access on that definition
# 5. On each product → Metafields → Gallery → upload lifestyle media
# Optional overrides:
# SHOPIFY_GALLERY_METAFIELD_NAMESPACE=custom
# SHOPIFY_GALLERY_METAFIELD_KEY=gallery
#
# PDP copy (headline, bullets, how-to, FAQ) — JSON metafield:
# 1. Products metafield definition Name: PDP | key: custom.pdp | Type: JSON
# 2. Enable Storefront API access
# 3. Sync from Gelos: pnpm shopify:sync-catalog
#
# Admin API (required for sync + checkout discounts):
# Dev Dashboard app → Versions: include write_discounts, write_draft_orders, write_products
# Dev Dashboard → Settings: copy Client ID + Secret (no API credentials page)
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Optional legacy static token (expires / 401 on new Dev Dashboard apps):
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
# SHOPIFY_ADMIN_API_VERSION=2025-01
# Gallery URL manifest (optional): data/shopify-gallery-sources.json
# Then:
#   pnpm shopify:sync-catalog -- --dry-run
#   pnpm shopify:sync-catalog
#   pnpm shopify:sync-catalog -- --gallery

# Exchange rates from catalog base currency (GHS) to checkout currencies.
# Units of target currency per 1 GHS. Update with live rates as needed.
# EXCHANGE_RATES={"GHS":1,"USD":0.064,"NGN":108}

# Optional — used for Paystack callback URLs, emails, Meta catalog links
# Production: https://www.gelosglobal.com (prefer www; apex redirects to www)
NEXT_PUBLIC_APP_URL=https://www.gelosglobal.com

# Better Auth — admin CMS sign-in (/admin/login)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production: must be the live site origin (https://www.gelosglobal.com). No trailing slash.
# Local: http://localhost:3000
# If users can visit both www and non-www, both are trusted automatically.
BETTER_AUTH_URL=https://www.gelosglobal.com
# Optional extra origins (comma-separated), e.g. Vercel preview URLs
# BETTER_AUTH_TRUSTED_ORIGINS=https://gelos-store.vercel.app
# Set to true only if your proxy exposes the public host via x-forwarded-host only
# BETTER_AUTH_TRUSTED_PROXY_HEADERS=false
# Optional comma-separated user IDs that always have admin access
BETTER_AUTH_ADMIN_USER_IDS=

# Bootstrap the first Gelos admin account (run: pnpm db:seed-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Gelos Admin

# Meta Pixel — ad conversion tracking (https://business.facebook.com/events_manager)
NEXT_PUBLIC_META_PIXEL_ID=
# Meta product catalog feed (CSV/TSV/XML) for Commerce Manager:
#   /api/feeds/meta-catalog?format=csv
#   /api/feeds/meta-catalog?format=tsv
#   /api/feeds/meta-catalog?format=xml
# Or export a file: pnpm export:meta-catalog -- --format=csv

# Storefront WhatsApp chat button (bottom-right). Digits only with country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional pre-filled message when opening WhatsApp
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi Gelos! I'd like some help with my order.

# WhatsApp Cloud API order agent (runs on Vercel at /api/whatsapp/*)
# Meta webhook Callback URL: https://www.gelosglobal.com/api/whatsapp/webhook
# Keep WHATSAPP_AGENT_ENABLED=false until Meta webhook + OpenAI are configured.
WHATSAPP_AGENT_ENABLED=false
WHATSAPP_AGENT_ADMIN_TOKEN=
WHATSAPP_OPENAI_API_KEY=
# Or reuse a general OpenAI key:
# OPENAI_API_KEY=
WHATSAPP_OPENAI_MODEL=gpt-5.4-mini
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
STAFF_WHATSAPP_NUMBER=
# Meta Commerce Catalog (optional). Leave WHATSAPP_META_CATALOG_MESSAGES=false
# to keep simple in-chat product image cards. Set true only after catalog_management
# token + catalog linked to WABA.
META_CATALOG_ID=
WHATSAPP_META_CATALOG_MESSAGES=false
# Optional Excel sync (Microsoft Graph)
WHATSAPP_EXCEL_SYNC_ENABLED=false
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REFRESH_TOKEN=
# EXCEL_DRIVE_ITEM_ID=
# EXCEL_TABLE_NAME=GelosOrders

# Groq — Gelos AI shopping assistant (https://console.groq.com/keys)
GROQ_API_KEY=

# Resend — order confirmation + admin alerts (domain: gelosglobal.com)
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender on your Resend domain
RESEND_FROM_EMAIL=Gelos <orders@gelosglobal.com>
# Inbox(es) that receive new-order notifications (comma-separated for multiple)
ADMIN_NOTIFICATION_EMAIL=hello@gelosglobal.com,gelosbrandinfo@gmail.com

# PushAlert — mobile web-push alerts for new orders
# Copy the script URL from PushAlert Dashboard > Integration > Universal.
NEXT_PUBLIC_PUSHALERT_SCRIPT_URL=https://cdn.pushalert.co/unified_0b434e691e906e37f3d2da30b812bb3b.js
# Server-only key from PushAlert Dashboard > Settings > REST API Key.
PUSHALERT_API_KEY=

# Mark's Dental Clinic partner portal — /dentist
DENTIST_DASHBOARD_PASSWORD=
